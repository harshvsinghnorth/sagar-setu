{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "marine.api:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "api-offline",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "marine.api:app", "--port", "8000"],
      "env": { "FORCE_OFFLINE": "1" },
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "cwd": "web",
      "port": 5173
    }
  ]
}
