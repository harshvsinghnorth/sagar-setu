{
  // Ctrl+Shift+P → "Tasks: Run Task" → "Sagar Setu: start" opens both servers,
  // then browse to http://localhost:5173. Stop each with Ctrl+C in its terminal.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sagar Setu: API",
      "type": "shell",
      "command": "uv run uvicorn marine.api:app --port 8000 --reload",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "sagar-setu", "reveal": "always" }
    },
    {
      "label": "Sagar Setu: web",
      "type": "shell",
      "command": "npm run dev -- --port 5173",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "sagar-setu", "reveal": "always" }
    },
    {
      "label": "Sagar Setu: start",
      "dependsOn": ["Sagar Setu: API", "Sagar Setu: web"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
